# Copy to .env and fill in real values. Never commit .env to source control.

# ── Django Core ──────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# ── SMS Notifications (optional — Fast2SMS India) ────────────────────────────
FAST2SMS_API_KEY=

# ── Email / SMTP Configuration ───────────────────────────────────────────────
# Used to send booking confirmation emails to customers.
# Example below uses Gmail with an App Password (2FA must be enabled).
# For other providers replace host/port values accordingly.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-here
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=PARK NEST <your-email@gmail.com>
